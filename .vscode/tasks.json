{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build kiosk system",
      "type": "shell",
      "command": "g++",
      "args": ["-std=c++11", "-Wall", "-Wextra", "-g", "*.cpp", "-o", "kiosk.exe"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "detail": "Compiles every .cpp in the folder into kiosk.exe (Ctrl+Shift+B)"
    },
    {
      "label": "Build and run",
      "type": "shell",
      "command": "${workspaceFolder}/kiosk.exe",
      "dependsOn": "Build kiosk system",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "new" }
    }
  ]
}
